#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker awscli jq

systemctl enable docker
systemctl start docker

mkdir -p /opt/in-memory-db

cat > /usr/local/bin/fetch-env.sh <<'EOF'
#!/bin/bash
set -euo pipefail

REGION="${aws_region}"
PREFIX="${ssm_parameter_prefix}"
OUT_FILE="/opt/in-memory-db/.env"
PROMETHEUS_FILE="/opt/in-memory-db/prometheus.yml"

get_param() {
  aws ssm get-parameter \
    --name "$1" \
    --with-decryption \
    --region "$REGION" \
    --query 'Parameter.Value' \
    --output text
}

get_param_optional() {
  aws ssm get-parameter \
    --name "$1" \
    --with-decryption \
    --region "$REGION" \
    --query 'Parameter.Value' \
    --output text 2>/dev/null || true
}

cat > "$OUT_FILE" <<EOT
DATABASE_URL=$(get_param "${ssm_parameter_prefix}/DATABASE_URL")
PORT=$(get_param "${ssm_parameter_prefix}/PORT")
ENV=$(get_param "${ssm_parameter_prefix}/ENV")
JWT_SECRET=$(get_param "${ssm_parameter_prefix}/JWT_SECRET")
REDIS_TCP_ENABLED=$(get_param "${ssm_parameter_prefix}/REDIS_TCP_ENABLED")
REDIS_TCP_PORT=$(get_param "${ssm_parameter_prefix}/REDIS_TCP_PORT")
DB_MAX_OPEN_CONNS=$(get_param "${ssm_parameter_prefix}/DB_MAX_OPEN_CONNS")
DB_MAX_IDLE_CONNS=$(get_param "${ssm_parameter_prefix}/DB_MAX_IDLE_CONNS")
DB_CONN_MAX_LIFETIME=$(get_param "${ssm_parameter_prefix}/DB_CONN_MAX_LIFETIME")
DB_CONN_MAX_IDLE_TIME=$(get_param "${ssm_parameter_prefix}/DB_CONN_MAX_IDLE_TIME")
EOT

chmod 600 "$OUT_FILE"

REMOTE_WRITE_URL=$(get_param_optional "${ssm_parameter_prefix}/PROMETHEUS_REMOTE_WRITE_URL")
REMOTE_WRITE_USERNAME=$(get_param_optional "${ssm_parameter_prefix}/PROMETHEUS_REMOTE_WRITE_USERNAME")
REMOTE_WRITE_PASSWORD=$(get_param_optional "${ssm_parameter_prefix}/PROMETHEUS_REMOTE_WRITE_PASSWORD")

RW_URL_ESCAPED=$(printf '%s' "$REMOTE_WRITE_URL" | sed 's/"/\\"/g')
RW_USER_ESCAPED=$(printf '%s' "$REMOTE_WRITE_USERNAME" | sed 's/"/\\"/g')
RW_PASS_ESCAPED=$(printf '%s' "$REMOTE_WRITE_PASSWORD" | sed 's/"/\\"/g')

cat > "$PROMETHEUS_FILE" <<EOT
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "api"
    metrics_path: /metrics
    static_configs:
      - targets: ["localhost:8080"]

  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]
EOT

if [ -n "$REMOTE_WRITE_URL" ] && [ -n "$REMOTE_WRITE_USERNAME" ] && [ -n "$REMOTE_WRITE_PASSWORD" ]; then
  cat >> "$PROMETHEUS_FILE" <<EOT

remote_write:
  - url: "$RW_URL_ESCAPED"
    basic_auth:
      username: "$RW_USER_ESCAPED"
      password: "$RW_PASS_ESCAPED"
EOT
fi

chmod 600 "$PROMETHEUS_FILE"
EOF

chmod +x /usr/local/bin/fetch-env.sh

cat > /etc/systemd/system/in-memory-db.service <<EOF
[Unit]
Description=In Memory DB API Docker Service
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10

ExecStartPre=/usr/local/bin/fetch-env.sh
ExecStartPre=/bin/bash -c '/usr/bin/aws ecr get-login-password --region ${aws_region} | /usr/bin/docker login --username AWS --password-stdin ${ecr_registry}'
ExecStartPre=-/usr/bin/docker rm -f ${container_name}
ExecStartPre=/usr/bin/docker pull ${ecr_repository_url}:latest
ExecStart=/usr/bin/docker run --name ${container_name} --env-file /opt/in-memory-db/.env -p ${app_port}:${app_port} -p ${redis_port}:${redis_port} --restart unless-stopped ${ecr_repository_url}:latest
ExecStop=/usr/bin/docker stop ${container_name}
ExecStopPost=-/usr/bin/docker rm -f ${container_name}

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable in-memory-db
systemctl start in-memory-db
